ENVIRONMENT=development
DEBUG=true

DATABASE_URL=postgresql+asyncpg://collabflow:collabflow@localhost:5432/collabflow

JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

REDIS_URL=redis://localhost:6379/0

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@collabflow.local

S3_ENDPOINT_URL=http://localhost:9000
# S3_PUBLIC_ENDPOINT_URL=       # unset here (both already localhost); set to the
                                 # host-mapped address in docker-compose.yml, where
                                 # S3_ENDPOINT_URL is the internal service name "minio"
S3_ACCESS_KEY=collabflow
S3_SECRET_KEY=collabflow123
S3_BUCKET=collabflow-attachments
MAX_ATTACHMENT_SIZE_MB=10

# SENTRY_DSN=            # unset by default — Sentry never initializes without it

CORS_ORIGINS=["http://localhost:5173"]
